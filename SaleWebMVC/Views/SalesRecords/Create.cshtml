@using Microsoft.AspNetCore.Mvc.Rendering
@using SalesWebMVC.Models
@using SalesWebMVC.Models.Enums
@model SalesWebMVC.Models.ViewModels.SalesFromViewModel;

@{
    ViewData["Title"] = "New sale";
}

<div class="row">
    <div class="col-md-8">
        <h1 class="text-primary-emphasis">@ViewData["Title"]</h1>
    </div>
    <div class="col-4">
        <a asp-action="Index" class="btn btn-lg btn-secondary float-end"><i class="fas fa-arrow-left me-2"></i>Back</a>
    </div>
</div>
<hr />

<div class="row align-content-center">
    <div class="col-md-12">
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="Create" id="createForm">
            @if (Model.SalesRecord.OrderItems.Count == 0)
            {
                <input type="hidden" name="SalesRecord.OrderItems.Index" value="0" />
            }
            <h3 class="text-primary">Sales info</h3>
            <div class="row">
                <div class="col-md-6 form-group p-2">
                    <label asp-for="SalesRecord.DepartmentId" class="control-label">Department</label>
                    <select id="DepartmentId"
                            asp-for="SalesRecord.DepartmentId"
                            asp-items="@(new SelectList(Model.Departments, "Id", "Name", Model.SalesRecord.DepartmentId))"
                            class="form-control">
                        <option value="">-- Select the department --</option>
                    </select>
                </div>

                <div class="col-md-6 form-group p-2">
                    <label asp-for="SalesRecord.SellerId" class="control-label">Seller</label>
                    <select id="SellerId"
                            asp-for="SalesRecord.SellerId"
                            asp-items="@(new SelectList(Model.Sellers, "Id", "UserFullName", Model.SalesRecord.SellerId))"
                            class="form-control">
                        <option value="">-- Select the Seller --</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 form-group p-2">
                    <label asp-for="SalesRecord.Date" class="control-label"></label>
                    <input asp-for="SalesRecord.Date" class="form-control" />
                </div>

                <div class="col-md-6 form-group p-2">
                    <label asp-for="SalesRecord.Status" class="control-label"></label>
                    <select asp-for="SalesRecord.Status" asp-items="Html.GetEnumSelectList<SalesStatus>()" class="form-control"></select>
                    <small class="form-text text-muted">All new sale are saved as @SalesStatus.Pending.ToString().</small>
                </div>
            </div>

            <hr class="mt-4 mb-4" />
            <h3 class="text-primary">Sale Items (<span id="item-count">0</span>)</h3>

            <div id="order-items-container">
            </div>

            <div class="text-end mt-3 mb-4 p-3 border-top border-bottom border-primary-subtle">
                <h3 class="m-0">
                    Total Amount: R$ <span id="grand-total-display">0.00</span>
                </h3>
            </div>

            <div class="form-group mb-4">
                <button type="button" id="add-item-btn" class="btn btn-success"><i class="fas fa-plus-circle me-2"></i>Add Item</button>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Create Sale" class="btn btn-primary btn-lg" />
            </div>
        </form>
    </div>
</div>


<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog justify-content-center">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="successModalLabel">Success</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Sale created with success!</p>
            </div>
            <div class="modal-footer text-center w-100">
                <button type="button" id="goToIndexBtn" class="btn btn-sucess align-content-center">Ok</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        // 1. Constrói o HTML das opções (como fizemos na última solução, usando StringBuilder)
        var htmlOptionsBuilder = new System.Text.StringBuilder();
        if (Model.Products != null)
        {
            foreach (var item in Model.Products)
            {
                htmlOptionsBuilder.Append($"<option value=\"{item.Id}\">{item.Name}</option>");
            }
        }
        string productOptionsHtmlRaw = htmlOptionsBuilder.ToString();
    }

    <script id="products-data" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Products ?? new List<SalesWebMVC.Models.ViewModels.SalesFromViewModel.ProductDto>()))
    </script>

    <script id="product-options-html" type="text/template">
        @* Usamos text/template ou um tipo não executável para injetar a string HTML bruta *@
        <option value="">-- Select Product --</option>
        @Html.Raw(productOptionsHtmlRaw)
    </script>
    @* Certifique-se de que os caminhos abaixo estejam corretos e que os arquivos existam *@
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/SalesRecords/SalesRecords-Create.js" defer>  
        
    </script>

}