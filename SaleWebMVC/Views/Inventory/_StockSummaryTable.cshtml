@model IEnumerable<SalesWebMVC.Models.InventoryMovement>
@using SalesWebMVC.Models.Enums

<table id="movementsTable" class="table table-striped table-bordered table-hover">
    <thead>
        <tr class="table-primary">
            <th>#</th>
            <th>@Html.DisplayNameFor(Model => Model.Product.Name)</th>
            <th>@Html.DisplayNameFor(Model => Model.Product.Supplier.Name)</th>
            <th>@Html.DisplayNameFor(Model => Model.Product.StockQuantity)</th>
            <th>@Html.DisplayNameFor(Model => Model.Quantity)</th>
            <th>Status</th>
            <th>@Html.DisplayNameFor(Model => Model.Observation)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var rowClass = item.Product.NeedsRestock() ? "table-danger" : "table-secondary";
            <tr class="table-active @rowClass">
                <td>@Html.DisplayFor(modelItem => item.Id)</td>
                <td>@Html.DisplayFor(modelItem => item.Product.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Product.Supplier.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Product.StockQuantity)</td>
                <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                <td>
                    @if (item.Product.NeedsRestock())
                    {
                        <span class="badge bg-danger">Needs Restock</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Sufficient Stock</span>
                    }
                </td>
                <td>@Html.DisplayFor(modelItem => item.Observation)</td>
                <td class="text-center">
                    <a class="btn btn-sm btn-info" asp-controller="Products" asp-action="Edit" asp-route-id="@item.Product.Id">
                        <i class="fa fa-edit"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
